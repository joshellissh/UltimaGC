--- a/arch/arm64/boot/dts/ti/k3-am67a-beagley-ai.dts
+++ b/arch/arm64/boot/dts/ti/k3-am67a-beagley-ai.dts
@@ -1025,3 +1025,78 @@
 	phys = <&serdes0_usb_link>;
 	phy-names = "cdns3,usb3-phy";
 };
+
+&main_pmx0 {
+	main_i2c2_pins_default: main-i2c2-default-pins {
+		pinctrl-single,pins = <
+			J722S_IOPAD(0x00b0, PIN_INPUT_PULLUP, 1) /* (P22) GPMC0_CSn2.I2C2_SCL */
+			J722S_IOPAD(0x00b4, PIN_INPUT_PULLUP, 1) /* (P23) GPMC0_CSn3.I2C2_SDA */
+		>;
+	};
+};
+
+&main_i2c2 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	pinctrl-names = "default";
+	pinctrl-0 = <&main_i2c2_pins_default>;
+	clock-frequency = <400000>;
+
+	/* MYIR MY-CAM004M quad-AHD decoder, CSI0 connector -- see mycam004m.c /
+	 * mycam004m-regs.h in the mycam004m repo for the chip itself.
+	 * main_i2c2 -> CSI0 routing bench-confirmed 2026-08-31: the N4 ACKs on
+	 * this bus at 0x31 -- DEV_ID (0xf4, bank 0) read back 0xb0 via i2cget.
+	 * 0x31 is the chip's real address everywhere: BeaglePlay bring-up hit
+	 * the same thing (see beagleplay-falcon/NOTES.md in UltimaGC history,
+	 * 2026-08-23) -- the mycam004m repo's committed 0x30 was a pre-bench
+	 * schematic misread, fixed on that bench but never committed back.
+	 * cdns_csi2rx0/dphy0/ti_csi2rx0 (instance 0) is bench-confirmed too:
+	 * 1080p UYVY frames DMA out of ticsi2rx context 0 (/dev/video6) from a
+	 * live AHD source. Streaming gotcha: both CSI subdevs default to
+	 * 640x480 and STREAMON EPIPEs until userspace sets 1080p on them via
+	 * media-ctl -V -- see the mycam004m repo's docs/testing.md step 4.
+	 * reset-gpios/pwren-gpios intentionally omitted -- unwired GPIOs are
+	 * fine, the same setup worked on BeaglePlay without them.
+	 */
+	mycam004m: camera@31 {
+		compatible = "myir,mycam004m";
+		reg = <0x31>;
+
+		port {
+			mycam004m_out: endpoint {
+				remote-endpoint = <&csi2rx0_in_mycam004m>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <1242000000>;
+			};
+		};
+	};
+};
+
+&cdns_csi2rx0 {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		csi0_port0: port@0 {
+			reg = <0>;
+			status = "okay";
+
+			csi2rx0_in_mycam004m: endpoint {
+				remote-endpoint = <&mycam004m_out>;
+				bus-type = <4>; /* CSI2 DPHY */
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+};
+
+&dphy0 {
+	status = "okay";
+};
+
+&ti_csi2rx0 {
+	status = "okay";
+};
