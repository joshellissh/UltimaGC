[Unit]
Description=Symlink /dev/mycam/cam1..4 to the configured mycam004m backend
# Same DefaultDependencies=no / local-fs.target shape as ultima-data-mount.service
# and ultima-app.service — see ultima-data-mount.service's own comment for why
# the implicit After=sysinit.target (default systemd behavior) would otherwise
# fight a Before=ultima-app.service ordering here too.
DefaultDependencies=no
After=ultima-data-mount.service
Wants=ultima-data-mount.service
After=systemd-modules-load.service
Before=ultima-app.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mycam004m-select-backend.sh

[Install]
WantedBy=local-fs.target
