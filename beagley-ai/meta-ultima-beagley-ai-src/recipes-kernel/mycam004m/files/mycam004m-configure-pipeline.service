[Unit]
Description=Bring up the real mycam004m CSI pipeline (wait for nodes, resolve symlinks, set subdev formats)
# Runs after the early mycam004m-select-backend.service so this never races
# a fake-backend resolve, and after systemd-modules-load (which force-loads
# the whole CSI stack — see modules-load.d/mycam004m.conf) so the media graph
# it waits on is actually assembling. Needs /data mounted for the
# camera-backend choice. Deliberately NOT ordered Before=ultima-app.service:
# the app only opens /dev/mycam/camN when a camera screen is brought up, and
# the bounded node wait in the script must never delay first dash frame —
# that's the whole reason this is a separate unit instead of more work in
# mycam004m-select-backend.service.
After=systemd-modules-load.service ultima-data-mount.service mycam004m-select-backend.service
Wants=ultima-data-mount.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/mycam004m-configure-pipeline.sh

[Install]
WantedBy=multi-user.target
