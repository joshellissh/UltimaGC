[Unit]
Description=Mount /data from whichever disk (SD or eMMC) root itself booted from
# DefaultDependencies=no is load-bearing, not boilerplate — found out the hard
# way. Without it this unit also gets the implicit After=sysinit.target every
# .service gets by default, which directly contradicts Before=local-fs.target
# below (local-fs.target itself precedes sysinit.target in the normal boot
# chain). That contradiction is a real dependency cycle, and systemd breaks
# cycles by deleting an arbitrary job rather than refusing to boot — on
# hardware it silently dropped systemd-tmpfiles-setup.service's start job
# instead of this unit's, which meant /var/volatile/tmp and
# /var/volatile/log never got created, which took down dbus-broker's
# PrivateTmp= (EROFS trying to bind-mount a directory that doesn't exist)
# and cascaded into avahi-daemon/systemd-logind/systemd-resolved all
# failing (confirmed via `journalctl -b | grep -i "ordering cycle"` showing
# ultima-data-mount.service in every one of the printed cycle chains).
# volatile-binds' own service template sets this same flag for the same
# reason — should have copied it the first time.
# Dropped After=/Wants=systemd-udevd.service (2026-08-11): looked load-bearing
# (this unit mounts a block device, udev feels like the obvious prerequisite)
# but isn't. ultima-data-mount.sh keys off a raw /dev/mmcblk0pN /
# /dev/mmcblk1pN node (see that script's own comment on why — never a udev
# symlink), and the kernel's own MMC block-layer partition scan creates that
# node via devtmpfs at driver-probe time, confirmed on hardware at kernel_ts
# ~0.48s ("mmcblk0: p1 p2 p3" in dmesg) — over a second before systemd-udevd
# even starts, let alone finishes. /data's own mountpoint directory is baked
# into the rootfs at build time too (`install -d ${D}/data` in ultima-app.bb),
# not created by systemd-tmpfiles at runtime, so there's no other hidden
# prerequisite either. Exact same stale-holdover shape as the dev-fb0.device
# trap ultima-app.service's own comment already warns about — this unit had
# the same bug, just not yet found. Removing it let this unit (and
# ultima-app.service behind it) start ~0.9-1.1s earlier on hardware, with
# zero failed units / ordering cycles and a verified-clean odometer-persistence
# reboot test after.
DefaultDependencies=no
Before=local-fs.target ultima-app.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ultima-data-mount.sh

[Install]
WantedBy=local-fs.target
