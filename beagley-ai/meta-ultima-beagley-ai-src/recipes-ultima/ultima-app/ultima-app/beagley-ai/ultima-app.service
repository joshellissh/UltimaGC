[Unit]
Description=Ultima gauge cluster
DefaultDependencies=no
After=ultima-data-mount.service
Wants=ultima-data-mount.service
After=systemd-modules-load.service
# /tmp is a tmpfs (tmp.mount); without this the ExecStartPre mkdir can land
# on the rootfs a moment before the tmpfs is mounted over it.
After=tmp.mount
Conflicts=shutdown.target
Before=shutdown.target
StartLimitIntervalSec=0

[Service]
# Type=notify: main.cpp sends READY=1 from the first rendered frame
# (notifySystemd). systemd-udev-trigger.service.d/ultima-after-dash.conf
# orders udev's coldplug — and with it the ~50 module loads, remoteproc
# firmware, WiFi, sound, video codecs — After=ultima-app.service, so all of
# that starts once the dash is on screen rather than while the app is
# loading its libraries off the same SD card. Measured 2026-08-30 on the
# falcon boot: the app took 5.4 s from main() to first frame at boot vs
# 1.9 s for a restart with a cold page cache — the difference was
# one-time GPU init plus exactly that contention. If the app never renders
# (no display), TimeoutStartSec fails the unit and the rest of the boot
# proceeds anyway.
Type=notify
NotifyAccess=main
TimeoutStartSec=45
ExecStartPre=/bin/mkdir -p /tmp/runtime
ExecStartPre=/bin/mkdir -p /data/qt-shader-cache
ExecStart=/usr/bin/ultima-app
# GPU path (eglfs on the tidss KMS device, PowerVR BXS-4-64 via
# ti-img-rogue-driver + Mesa's PVR shim), confirmed on hardware 2026-08-30
# — the first bring-up ran linuxfb + the software Quick backend to isolate
# the app from the GPU stack; that is no longer needed. Both lines together:
# qtbase is built -opengl es2, so eglfs without eglfs_kms (or linuxfb
# without QT_QUICK_BACKEND=software) leaves Quick with no usable context.
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_INTEGRATION=eglfs_kms
Environment=XDG_RUNTIME_DIR=/tmp/runtime
Environment=XDG_CACHE_HOME=/data/qt-shader-cache
# Win the boot-time scheduling fights against journald/udevd/tmpfiles for
# the cores and the card. Nothing else at boot is latency-sensitive.
Nice=-10
IOSchedulingClass=best-effort
IOSchedulingPriority=0
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=local-fs.target
