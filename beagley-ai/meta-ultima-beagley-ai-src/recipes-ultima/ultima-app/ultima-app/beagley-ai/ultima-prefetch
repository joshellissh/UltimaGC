#!/bin/sh
# Sequentially read everything ultima-app maps at startup (see
# ultima-prefetch.list) so the app's exec + dynamic linking hit the page
# cache instead of the SD card. One big sequential sweep is what the card
# is good at; the on-demand alternative is thousands of small faults. Files
# that don't exist on this image are simply skipped.
#
# Regenerate the list from a running board with:
#   awk '{print $6}' /proc/$(pidof ultima-app)/maps | grep '\.so' | sort -u
LIST=/etc/ultima/prefetch.list
exec 2>/dev/null
cat /usr/bin/ultima-app >/dev/null
[ -r "$LIST" ] || exit 0
while read -r f; do
    case "$f" in ''|'#'*) continue ;; esac
    [ -r "$f" ] && cat "$f" >/dev/null
done < "$LIST"
exit 0
