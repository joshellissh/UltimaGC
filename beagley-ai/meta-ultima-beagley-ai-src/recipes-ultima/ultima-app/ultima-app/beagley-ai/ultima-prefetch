#!/bin/sh
# Pull the gauge cluster's startup working set into the page cache before the
# app is exec'd (ultima-prefetch.service starts in systemd's first
# transaction, ~0.4 s ahead of the app). Two sources, best first:
#
#  1. /etc/ultima/readahead.pack — page ranges recorded on the bench with
#     `ultima-readahead record` (see recipes-ultima/ultima-readahead): only
#     the pages the boot actually touched, in the order they were mapped.
#     Files whose size changed since the recording are skipped, so a stale
#     pack degrades to "less prefetch", never a broken boot. Regenerate it
#     after a Qt/Mesa/app update:
#       systemctl mask ultima-prefetch; reboot   (so the cache is honest)
#       ultima-readahead record /tmp/pack $(pidof ultima-app) \
#           /lib/firmware/rgx.fw.36.53.104.796 /lib/firmware/rgx.sh.36.53.104.796
#       scp it back as ultima-app/beagley-ai/readahead.pack; unmask.
#  2. /etc/ultima/prefetch.list — whole files, sequential cat. Fallback when
#     there is no pack.
exec 2>/dev/null
PACK=/etc/ultima/readahead.pack
if [ -s "$PACK" ] && [ -x /usr/bin/ultima-readahead ]; then
    exec /usr/bin/ultima-readahead replay "$PACK"
fi
LIST=/etc/ultima/prefetch.list
cat /usr/bin/ultima-app >/dev/null
[ -r "$LIST" ] || exit 0
while read -r f; do
    case "$f" in ''|'#'*) continue ;; esac
    [ -r "$f" ] && cat "$f" >/dev/null
done < "$LIST"
exit 0
