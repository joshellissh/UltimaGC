# MikroE CAN SPI 3.3V click (MCP2515 + SN65HVD230) on the board's SPI bus.
# Bring up can0 at 1 Mbit/s once the mcp251x driver registers the interface.
# Syvecs S7+ CAN2 runs at 1M on this car (verified in SCal: Datastreams →
# CAN2 Bus Speed).
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="spi", DRIVERS=="mcp251x", \
  RUN+="/sbin/ip link set %k type can bitrate 1000000", \
  RUN+="/sbin/ip link set %k up"

# ODrive USB-CAN adapter (gs_usb / candleLight class, VID:PID 1d50:606f) —
# temporarily re-added 2026-08-21 alongside the rule above for bench testing
# while the SPI click isn't physically seated yet. Drop
# this block again once the click is seated and verified end-to-end.
SUBSYSTEM=="net", ACTION=="add", DEVPATH=="*/usb*", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", \
  RUN+="/sbin/ip link set %k type can bitrate 1000000", \
  RUN+="/sbin/ip link set %k up"
