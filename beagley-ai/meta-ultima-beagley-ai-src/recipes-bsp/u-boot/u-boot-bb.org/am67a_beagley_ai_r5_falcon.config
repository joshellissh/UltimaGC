# Falcon boot on BeagleY-AI (AM67A/J722S), R5 SPL side.
#
# The bb.org U-Boot tree has none of TI-staging's k3_falcon_* code, and it
# doesn't need it: the stock R5 SPL already loads a FIT whose "firmware" is
# ATF and whose "loadables" are OP-TEE + DM firmware, then starts ATF on the
# A53 (arch/arm/mach-k3/r5/common.c jump_to_image). tifalcon.bin is that
# same FIT with the A53 SPL swapped for the kernel Image + DTB as two more
# loadables, at the addresses the rebuilt TF-A jumps to. The same recipe TI
# (Keerthy J) published for J721S2 and that was confirmed booting on a
# J722S HS-FS EVM (E2E thread 1376134), and the addresses TI's own MCU+ SDK
# FALCON_MODE uses for j722s-evm.
#
# Memory map (DDR starts at 0x80000000):
#   0x80000000  ATF        CONFIG_K3_ATF_LOAD_ADDR (unchanged)
#   0x80080000  FIT header CONFIG_SPL_LOAD_FIT_ADDRESS (unchanged; the FIT is
#                          built with external data, so only metadata lands
#                          here — never build tifalcon.bin without mkimage -E)
#   0x82000000  kernel     TF-A PRELOADED_BL33_BASE; Image is ~43 MiB incl. BSS
#   0x88000000  kernel DTB TF-A K3_HW_CONFIG_BASE
#   0x89000000  DM fw      binman default staging address (unchanged)
#   0x8c000000  SPL stack  CONFIG_SPL_STACK_R_ADDR — was 0x82000000, i.e. where
#                          the kernel now goes (malloc grows below it, 2 MiB)
#   0x9e800000  OP-TEE     CONFIG_K3_OPTEE_LOAD_ADDR (unchanged)
CONFIG_SPL_STACK_R_ADDR=0x8c000000

# Load tifalcon.bin instead of tispl.bin so the stock tispl.bin can stay on
# the boot partition untouched; swapping tiboot3.bin alone selects the mode.
CONFIG_SPL_FS_LOAD_PAYLOAD_NAME="tifalcon.bin"
