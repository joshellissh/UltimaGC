# Architecture
BR2_aarch64=y
BR2_cortex_a53=y

# Kernel headers (must come before toolchain C library selection)
BR2_KERNEL_HEADERS_6_6=y

# Patches applied automatically to any package below whose name matches a
# subdirectory here (Buildroot's BR2_GLOBAL_PATCH_DIR mechanism) — same
# pattern upstream's own beagleplay_defconfig uses via
# board/beagleboard/beagleplay/patches/. Currently just the GCC 14+
# qt5declarative cstdint fix (see qt5declarative/ below); keeping this
# mechanism wired up means any future patch just needs a new subdirectory,
# no defconfig/script changes.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/patches"

# Toolchain — Buildroot-internal, same as RPi5's defconfig. Originally this
# targeted upstream Buildroot's Bootlin toolchain to match its
# beagleplay_defconfig as closely as possible, but Bootlin's prebuilt
# toolchains are only published for x86_64 build hosts
# (toolchain/toolchain-external/toolchain-external-bootlin/Config.in has
# `depends on BR2_HOSTARCH = "x86_64"`) — invisible, and silently
# unselected, on an arm64 build host (e.g. an Apple Silicon OrbStack VM),
# which made `make ultima_beagleplay_defconfig` fall back to an empty
# "custom preinstalled" toolchain and fail at the very first configure step
# with "Cannot execute cross-compiler '/aarch64-linux-gcc'". The internal
# toolchain builds from source instead of downloading a prebuilt one (slower
# first build) but works on any build host architecture.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TOOLCHAIN_BUILDROOT_WCHAR=y

# Device management - eudev for /dev/input nodes
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Init system - BusyBox for fast boot (same as RPi5)
BR2_INIT_BUSYBOX=y

# Kernel — version pinned to match upstream beagleplay_defconfig's tested combo.
# (Originally scaffolded at 6.18.16, guessed as "the latest available" without
# ever diffing against this Buildroot checkout's own configs/beagleplay_defconfig
# — that file is the actual proven reference and pins 6.10; corrected to match
# after 6.18.16 traced back to other unverified guesses below breaking the build.)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.10"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="ti/k3-am625-beagleplay"

# Kernel fragments — CAN, WiFi, touchscreen, display fbdev emulation
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/kernel-fragments.cfg"

# WiFi firmware — onboard TI WL1807 (WiLink8), wl18xx/wlcore driver.
# Buildroot ships this firmware directly; unlike RPi5's brcmfmac, nothing
# needs to be manually placed in the overlay.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_TI_WL18XX=y

# Bootloader chain: ROM -> R5 loader (tiboot3.bin, wakeup domain) ->
# TF-A/OP-TEE -> U-Boot (tispl.bin + u-boot.img, A53 domain) -> extlinux.conf.
# Nothing here transfers from RPi5's firmware+EEPROM bootloader — this is a
# real secure boot chain. Version pins and board defconfig names below now
# match this exact Buildroot checkout's own configs/beagleplay_defconfig
# byte-for-byte (verified this checkout ships it; previously this block had
# invented version pins — v2.12-LTS TF-A and 2026.01 R5-loader/U-Boot — that
# were never actually diffed against that file. The U-Boot 2026.01 guess in
# particular doesn't exist as a real, complete release: its COPYING became a
# symlink to Licenses/gpl-2.0.txt but that file is missing from the tarball,
# which broke Buildroot's legacy pre-2013.10 license-copy hook on first
# extract. 2024.07 is the version this Buildroot release's own hash file
# expects and was actually tested against.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_VERSION_VALUE="v2.11"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="k3"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_TARGET_BOARD="lite"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL32_OPTEE=y
BR2_TARGET_OPTEE_OS=y
BR2_TARGET_OPTEE_OS_PLATFORM="k3-am62x"
BR2_TARGET_TI_K3_R5_LOADER=y
BR2_TARGET_TI_K3_R5_LOADER_CUSTOM_VERSION=y
BR2_TARGET_TI_K3_R5_LOADER_CUSTOM_VERSION_VALUE="2024.07"
BR2_TARGET_TI_K3_R5_LOADER_BOARD_DEFCONFIG="am62x_beagleplay_r5"
# BeaglePlay ships the General Purpose (GP) security variant — using the
# wrong tiboot3.bin here means the board won't boot at all.
BR2_TARGET_TI_K3_R5_LOADER_TIBOOT3_BIN="tiboot3-am62x-gp-evm.bin"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.07"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="am62x_beagleplay_a53"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/uboot-fragments.cfg"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="TEE=$(BINARIES_DIR)/tee-pager_v2.bin"
BR2_TARGET_UBOOT_USE_BINMAN=y
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_IMG=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot.img_unsigned"
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="tispl.bin_unsigned"

# Filesystem — read-only root + our own overlay/post-build/post-image,
# same pattern as RPi5 (separate /data partition, boot via extlinux.conf
# instead of RPi's config.txt/cmdline.txt)
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="320M"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ULTIMA_PATH)/board/ultima-beagleplay/post-image.sh"

# Image generation
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Qt5 — software rendering. No GPU driver package exists yet in Buildroot for
# AM625's PowerVR AXE-1-16M (open kernel driver landed Linux 6.8, GLES needs
# an unreleased-in-Buildroot Zink-on-Vulkan/Mesa 25.3+ path) — see "Rendering:
# Why Software, Not GPU" in SETUP-BEAGLEPLAY.md. linuxfb QPA + the QtQuick
# software backend draw straight to /dev/fb0 (via DRM_FBDEV_EMULATION on top
# of tidss), no EGL/Mesa/DRM userspace needed.
BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE=y
BR2_PACKAGE_QT5BASE_PNG=y
BR2_PACKAGE_QT5BASE_LINUXFB=y
BR2_PACKAGE_QT5BASE_FONTCONFIG=y
BR2_PACKAGE_QT5BASE_DEFAULT_QPA="linuxfb"
BR2_PACKAGE_QT5DECLARATIVE=y
BR2_PACKAGE_QT5DECLARATIVE_QUICK=y

# Input - touch support (reuse same Waveshare-style USB touch panel as RPi5)
BR2_PACKAGE_LIBINPUT=y
BR2_PACKAGE_EVTEST=y

# WiFi
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y

# Networking
BR2_PACKAGE_DHCPCD=y
BR2_PACKAGE_IPROUTE2=y

# CAN debug tools (candump/cansend for bring-up; not required at runtime) —
# CAN data itself comes over the ODrive USB-CAN adapter, same as RPi5.
BR2_PACKAGE_CAN_UTILS=y

# Fonts
BR2_PACKAGE_DEJAVU=y

# Utilities
BR2_PACKAGE_NANO=y
BR2_PACKAGE_DROPBEAR=y

# System
BR2_TARGET_GENERIC_HOSTNAME="ultima-bp"
BR2_TARGET_GENERIC_ISSUE="Ultima BeaglePlay"
BR2_TARGET_GENERIC_GETTY_PORT="ttyS2"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="wlan0"

# Ultima app package (shared, board-agnostic)
BR2_PACKAGE_ULTIMA_APP=y

# Strip for size
BR2_STRIP_strip=y
BR2_OPTIMIZE_S=y
BR2_ENABLE_LOCALE_PURGE=y
