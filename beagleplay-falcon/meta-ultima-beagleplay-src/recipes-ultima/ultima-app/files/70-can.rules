# MikroE CAN SPI 3.3V click (MCP2515 + SN65HVD230) on the mikroBUS header.
# Bring up can0 at 1 Mbit/s once the mcp251x driver registers the interface.
# Syvecs S7+ CAN2 runs at 1M on this car (verified in SCal: Datastreams →
# CAN2 Bus Speed).
SUBSYSTEM=="net", ACTION=="add", SUBSYSTEMS=="spi", DRIVERS=="mcp251x", \
  RUN+="/sbin/ip link set %k type can bitrate 1000000", \
  RUN+="/sbin/ip link set %k up"
