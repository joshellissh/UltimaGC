--- a/arch/arm64/boot/dts/ti/k3-am625-beagleplay.dts
+++ b/arch/arm64/boot/dts/ti/k3-am625-beagleplay.dts
@@ -979,3 +979,68 @@
 		interrupts = <9 IRQ_TYPE_LEVEL_LOW>;
 	};
 };
+
+/*
+ * MYIR MY-CAM004M -- quad-AHD-camera-input to 4-lane MIPI CSI-2 decoder,
+ * connected via J17. See ~/code/mycam004m (sibling repo, driver source of
+ * truth) for the register-level detail and citations; this node mirrors
+ * that repo's dts/k3-am625-beagleplay-mycam004m.dtso, converted from a
+ * runtime overlay to a compile-time patch for the same reason the
+ * mikroBUS CAN click above needed one -- Falcon boot never runs
+ * fdtoverlays (see NOTES.md "Falcon boot forces this to be a compile-time
+ * DT change, not a runtime overlay").
+ *
+ * reset-gpios/pwren-gpios are deliberately NOT set here, unlike the
+ * source repo's own overlay: the actual wired cable (see
+ * "docs/MY-CAM to BeaglePlay Pin Mapping.pdf" in UltimaGC) does not carry
+ * BeaglePlay's two J17 GPIOs (CSI2_CAMERA_GPIO1/2, main_gpio0 11/12) at
+ * all -- mycam004m.c requests both as fully optional
+ * (devm_gpiod_get_optional), so omitting the properties here is enough
+ * for it to skip GPIO sequencing entirely rather than drive pins the
+ * camera board was never wired to.
+ *
+ * reg = <0x31>, NOT the 0x30 the driver repo's own overlay and README
+ * document (from the schematic's "I2C add 0x61" label / SA0=SA1=Low
+ * formula) -- hardware-verified wrong on this actual board:
+ * `i2cdetect -y 4` after the first flash of this patch showed nothing at
+ * 0x30 but a real device at 0x31, and mycam004m's own probe failed with
+ * -EREMOTEIO ("failed selecting bank 0x00 for chip-ID readback") at 0x30
+ * before this fix. Whatever this board's actual SA0/SA1 strap is, 0x31 is
+ * what's really there -- see NOTES.md for the full before/after.
+ */
+&wkup_i2c0 {
+	status = "okay";
+
+	mycam004m: camera@31 {
+		compatible = "myir,mycam004m";
+		reg = <0x31>;
+
+		port {
+			mycam004m_out: endpoint {
+				remote-endpoint = <&csi2rx0_in_mycam004m>;
+				clock-lanes = <0>;
+				data-lanes = <1 2 3 4>;
+				link-frequencies = /bits/ 64 <1242000000>;
+			};
+		};
+	};
+};
+
+&csi0_port0 {
+	status = "okay";
+
+	csi2rx0_in_mycam004m: endpoint {
+		remote-endpoint = <&mycam004m_out>;
+		bus-type = <4>; /* CSI2 DPHY */
+		clock-lanes = <0>;
+		data-lanes = <1 2 3 4>;
+	};
+};
+
+&dphy0 {
+	status = "okay";
+};
+
+&ti_csi2rx0 {
+	status = "okay";
+};
