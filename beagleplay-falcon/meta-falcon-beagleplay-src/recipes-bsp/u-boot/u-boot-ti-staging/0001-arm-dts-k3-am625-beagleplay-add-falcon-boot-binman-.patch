From: BeaglePlay Falcon Mode <falcon@localhost>
Subject: [PATCH] arm: dts: k3-am625-beagleplay: add falcon boot binman node

BeaglePlay's binman devicetree never defines a "ti-falcon" node, so
tools/binman never assembles tifalcon.bin, and the falcon package
(u-boot-ti-staging-falcon) fails do_install with "cannot stat
tifalcon.bin". TI's own am625-sk board wires this up in
k3-am625-sk-binman.dtsi; this mirrors that node for BeaglePlay,
trimmed to the GP-only (non-HS) tifsstub variant BeaglePlay actually
builds (no tifsstub.bin_hs/_fs are produced for this board).

Upstream-Status: Inappropriate [board-specific, not submitted upstream]

--- a/arch/arm/dts/k3-am625-beagleplay-u-boot.dtsi
+++ b/arch/arm/dts/k3-am625-beagleplay-u-boot.dtsi
@@ -80,6 +80,45 @@
 		};
 	};
 
+	ti-falcon {
+		insert-template = <&ti_falcon_template>;
+
+		fit {
+			images {
+				tifsstub-gp {
+					description = "TIFSSTUB";
+					type = "firmware";
+					arch = "arm32";
+					compression = "none";
+					os = "tifsstub-gp";
+					load = <0x9dc00000>;
+					entry = <0x9dc00000>;
+					blob-ext {
+						filename = "tifsstub.bin_gp";
+					};
+				};
+				dm {
+					ti-secure {
+						content = <&dm_falcon>;
+						keyfile = "custMpk.pem";
+					};
+					dm_falcon: ti-dm {
+						filename = "ti-dm/am62xx/ipc_echo_testb_mcu1_0_release_strip.xer5f";
+					};
+				};
+			};
+
+			configurations {
+				default = "conf-0";
+				conf-0 {
+					description = "k3-am625-beagleplay-falcon";
+					firmware = "atf";
+					loadables = "tee", "dm", "tifsstub-gp";
+				};
+			};
+		};
+	};
+
 	ti-spl_unsigned {
 		filename = "tispl.bin_unsigned";
 		symlink = "tispl.bin";
