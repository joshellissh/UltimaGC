--- a/arch/arm/mach-k3/common.c
+++ b/arch/arm/mach-k3/common.c
@@ -605,7 +605,29 @@
 		       __func__, bootmedia, bootpart, ret);
 		return ret;
 	}
-	snprintf(str, sizeof(str), "console=%s root=PARTUUID=%s rootwait",
+	/*
+	 * ultima: append "quiet" -- this falcon cmdline is generated here at
+	 * boot time (via a fixed snprintf, not read from a file), and the
+	 * kernel's own CMDLINE_EXTEND choice does not exist on this
+	 * kernel/arch (arm64 arch/arm64/Kconfig only has
+	 * CMDLINE_FROM_BOOTLOADER/CMDLINE_FORCE, no EXTEND) -- so this is the
+	 * only place "quiet" can be added without a kernel CONFIG_CMDLINE
+	 * that would need a static, unknowable-at-build-time root PARTUUID
+	 * (this same image boots from both SD and eMMC with different
+	 * PARTUUIDs, fixed up right here from the live partition table).
+	 * printk to a 115200-baud UART console is synchronous, and systemd
+	 * itself also recognizes "quiet" on the kernel cmdline and
+	 * suppresses its own [ OK ]/Started status spam -- measured ~38KB of
+	 * console text by the time tidss inits on an unpatched boot, which
+	 * is ~3.3s of pure UART wire time on the critical path, not just
+	 * log noise.
+	 *
+	 * Also append "vt.global_cursor_default=0": once tidss brings up
+	 * fbcon on the HDMI output, the getty on tty1 blinks a text cursor
+	 * there until ultima-app takes the framebuffer over -- same fix
+	 * RPi5/Buildroot already carries in cmdline.txt.
+	 */
+	snprintf(str, sizeof(str), "console=%s root=PARTUUID=%s rootwait quiet vt.global_cursor_default=0",
 		 env_get("console"), info.uuid);
 
 	fdt_set_totalsize(fdt, fdt_totalsize(fdt) + CONFIG_SYS_FDT_PAD);
